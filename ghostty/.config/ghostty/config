# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# List available themes: ghostty +list-themes

theme = TokyoNight
font-family = JetBrainsMono Nerd Font
font-size = 12

# Window
window-padding-x = 6
window-padding-y = 6
window-decoration = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Clipboard
copy-on-select = clipboard

# Shell integration (zsh)
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Quick terminal / misc
confirm-close-surface = false

# SSH note: remote servers don't know the xterm-ghostty terminfo, which can
# break clear/colors/keys over SSH. Push it to a host once with:
#   infocmp -x | ssh HOST -- tic -x -
# (or uncomment the line below for maximum SSH compatibility)
# term = xterm-256color
