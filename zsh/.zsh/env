export CLICOLOR=1
export EDITOR=nvim
export VISUAL=nvim
export KEYTIMEOUT=1
# Default terminal for scripts; override in ~/.zshrc.local if needed.
if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
  export TERMINAL=alacritty
else
  export TERMINAL=ptyxis
fi

export GOPATH=$HOME/go
export GO111MODULE=on

# Consolidated PATH exports
export PATH=$PATH:$HOME/.npm-global/bin:$HOME/bin:$HOME/.local/bin:/usr/local/go/bin:$HOME/go/bin

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Flatpak app directories
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share"

# Preserve a desktop-provided SSH agent (for example on KDE). Otherwise,
# use GNOME Keyring's gcr socket, as on Fedora Workstation.
if [[ -z "${SSH_AUTH_SOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"
fi
