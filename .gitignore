# SSH keys (sensitive)
ssh/.ssh/id_rsa
ssh/.ssh/id_rsa.pub
ssh/.ssh/known_hosts*

# Local overrides (explicit names so scripts/.local/ stays trackable)
.gitconfig.local
.zshrc.local
*.local.json

# OS files
.DS_Store
Thumbs.db

# Generated
.zcompdump*

# Lazy lock (nvim plugin versions, keep but ignore lock)
# lazy-lock.json is kept for reproducibility

# Submodule content tracked separately
# .gitmodules is tracked, submodule dirs are not
